{
  "name": "pi-subagents",
  "version": "4.0.0",
  "description": "Tmux-only asynchronous subagents for Pi",
  "keywords": ["pi-package"],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "contributors": ["Martin Rumpelnik"],
  "repository": {
    "type": "git",
    "url": "https://github.com/mrumpelnik/pi-interactive-subagents.git"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/test.ts",
    "test:tmux": "node --test test/tmux-window.test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  }
}
